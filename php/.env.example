[app]
debug=true
trace=false
port=8080

[database]
hostname=127.0.0.1
database=
username=
password=
hostport=3306
charset=utf8mb4
prefix=
type=mysql
driver=mysql

[redis]
host=127.0.0.1
port=6379
password=
prefix=

[cache]
driver=file
host=127.0.0.1
port=6379
password=
select=0
prefix=

[session]
driver=file
select=1

[log]
type=file
log_version=1.0.0

[aliyunlog]
; 西贝统一 SLS 日志方案（access_key_id / access_key 用户自填）
end_point=cn-beijing-intranet.log.aliyuncs.com
access_key_id=
access_key=
project=xibei-system
logstore=inner_notp

[queue]
driver=redis
select=2
prefix=

[auth]
; 西贝营销中心凭证（敏感值，用户自填）
auth_appid=
auth_key=
private_key=
; 验签业务常量（业务标准，所有项目一致，§1.12.4）
timestamp_tolerance=300
nonce_ttl=300

[mdc]
; MDC 主数据服务地址（西贝集团共用，员工/地区/授权清单）
site_url=https://mdc.xibeidev.com

[rms]
; RMS 菜品中心服务地址（西贝集团共用）
rms_url=https://api.xibei.com.cn/rmsapi
mch_id=
xcx_appid=
; 员工角色权限菜单ID（getRoleList 必传）
menu_id=
; 鉴权 token 过期时间（秒），默认 1 小时
token_ttl=3600

[ftp]
; 静态服务器 FTP 配置
host=
user=
pwd=
rootdir=
passive=true
url=
temp_dir=/tmp
