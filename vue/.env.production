# 生产环境变量
# `vite build`（默认 mode=production）时加载

# 当前环境标识
VITE_APP_ENV=production
# 生产环境后端 API 地址
VITE_API_BASE_URL=https://api.example.com

# 构建时压缩算法：gzip / brotli / both / none
# 由 vite/plugins/compression.ts 读取并生成对应压缩产物
VITE_BUILD_COMPRESS=gzip

# C 端公共鉴权参数（ApiAuth 必传；按生产环境账号填）
VITE_MCH_ID=
VITE_EMPLOYEE_CODE=
